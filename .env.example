# Keep this TRUE to use the original browser-only demo without a cloud account.
NEXT_PUBLIC_DEMO_MODE=true

# To enable REAL Supabase mode, run the SQL migrations and set DEMO_MODE=false.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only canonical deployment origin. Required for production Cloud builds.
# Example: https://your-project.vercel.app (no path, query or trailing route).
APP_ORIGIN=

# Never place any service-role/secret key in NEXT_PUBLIC_* or Git.
