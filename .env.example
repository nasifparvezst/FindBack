# Keep this TRUE to use the original browser-only demo without a cloud account.
NEXT_PUBLIC_DEMO_MODE=true

# To enable REAL Supabase mode, run the SQL migrations and set DEMO_MODE=false.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only canonical deployment origin. Required for production Cloud builds.
# Example: https://your-project.vercel.app (no path, query or trailing route).
APP_ORIGIN=

# Never place any service-role/secret key in NEXT_PUBLIC_* or Git.
# Server only: required to create Admin password accounts; use one of these keys.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# One-time initial Admin. Choose a 12+ character password locally, then run npm run admin:bootstrap.
# Re-running that explicit command sets the password for this existing Admin.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
